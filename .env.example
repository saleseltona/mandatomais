# ============================================================================
# Mandato+ | Variáveis de Ambiente (Modelo para .env.local e Vercel)
# ============================================================================

# Obrigatórias — Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon-ou-publishable

# Obrigatórias — Aplicação e LGPD
# Em produção na Vercel, use o domínio final (ex.: https://mandatoplus.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONSENT_VERSION=1.0.0

# Recomendada em produção (privada, apenas servidor)
# Gere uma chave aleatória forte para pseudoanonimização HMAC-SHA256 de IP
IP_HASH_SECRET=gere-uma-chave-aleatoria-forte-em-producao

# Opcionais — Integração oficial Meta / Instagram (somente quando tiver App Meta aprovado)
# META_APP_ID=
# META_APP_SECRET=
